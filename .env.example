# Supabase (optionnel - pour la synchronisation cloud)
# Récupérez ces valeurs dans Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# NOTE : aucune clé Mistral n'est embarquée ni requise pour utiliser l'app.
# Chaque utilisateur connecte son propre compte Mistral depuis les paramètres ;
# la clé est stockée uniquement sur son appareil (aucun compte requis).
