# Supabase (requis pour la connexion du compte Mistral et la synchro cloud)
# Récupérez ces valeurs dans Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# NOTE : plus aucune clé Mistral n'est embarquée côté client.
# Chaque utilisateur connecte son propre compte Mistral depuis les paramètres
# (la clé est chiffrée côté Supabase Vault et jamais renvoyée au navigateur).
