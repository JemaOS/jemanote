# Supabase (optionnel - pour la synchronisation cloud)
# Récupérez ces valeurs dans Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# NOTE : aucune clé Mistral n'est embarquée ni requise pour utiliser l'app.
# Chaque utilisateur connecte son propre compte Mistral depuis les paramètres ;
# la clé est stockée uniquement sur son appareil (aucun compte requis).

# ─── Anti-robot ───────────────────────────────────────────────────────
# Active le proxy d'authentification `auth-guard` (rate limit + CAPTCHA à seuil).
# La fonction doit être déployée et ses secrets configurés (voir docs/CAPTCHA.md).
VITE_AUTH_GUARD_ENABLED=false
# CAPTCHA gratuit (Cloudflare Turnstile). Renseigner la clé de SITE ;
# le secret reste côté edge function (CAPTCHA_SECRET_KEY).
VITE_CAPTCHA_ENABLED=false
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=
