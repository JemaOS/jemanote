# Configuration de build (valeurs PUBLIQUES uniquement — aucune clé secrète).
# Le secret CAPTCHA reste côté edge function (Supabase secret CAPTCHA_SECRET_KEY).

# Proxy d'authentification anti-robot (edge function `auth-guard`).
VITE_AUTH_GUARD_ENABLED=true

# CAPTCHA gratuit (Cloudflare Turnstile).
VITE_CAPTCHA_ENABLED=true
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=0x4AAAAAAFYbIgdy41K_uPQL
